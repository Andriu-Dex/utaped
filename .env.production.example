# Copy to private .env.production; replace placeholders before deployment.
DB_PASSWORD=replace-with-a-unique-private-password
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
WEB_PORT=64430
WEB_BIND_ADDRESS=0.0.0.0
APP_PUBLIC_URL=https://utaped.example.invalid:64430
TLS_CERTIFICATE_FILE=C:/private/utaped/fullchain.pem
TLS_PRIVATE_KEY_FILE=C:/private/utaped/private.key
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
MAIL_FROM=utaped@example.invalid
AI_WRITING_ENABLED=false
AI_WRITING_PROVIDER=GROQ
AI_WRITING_MODEL=
GROQ_API_KEY=
OPENAI_API_KEY=
