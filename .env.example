DB_PASSWORD=replace-with-a-random-local-password
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-temporary-password
WEB_PORT=64430
APP_PUBLIC_URL=http://localhost:64430
COOKIE_SECURE=false
# Compatibilidad de documentos individuales históricos; los nuevos T1 por ámbito siempre son únicos.
PLANNING_SINGLE_PLAN_PER_SCOPE=false
PLANNING_ENFORCE_PREPARATION_WINDOW=true
PLANNING_TIME_ZONE=America/Guayaquil
# Días hábiles acumulados para prórrogas de evidencias y reapertura individual de elaboración.
PLANNING_MAX_EXTENSION_DAYS=3
# Límites técnicos iniciales; no constituyen una política institucional.
DOCUMENT_MAX_FILE_BYTES=10485760
DOCUMENT_MAX_REQUEST_BYTES=12582912
DOCUMENT_MAX_TOTAL_BYTES=52428800
DOCUMENT_MAX_ATTACHMENTS=20
DOCUMENT_MAX_ATTACHMENT_PAGES=100
DOCUMENT_PAGE_FORMAT=A4

# Límite técnico por exportación administrativa; ajuste entre 1 y 100000.
AUDIT_EXPORT_MAX_ROWS=10000
# Signing requires HTTPS by default. Enable HTTP only for isolated local development.
SIGNING_ALLOW_HTTP=false

# Uncompressed historical ZIP limit, including repeated file references and metadata.
PERIOD_ARCHIVE_MAX_BYTES=134217728
DEADLINE_NOTICES_ENABLED=true
DEADLINE_NOTICE_NEAR_DAYS=3
DEADLINE_NOTICE_REPEAT_DAYS=1
DEADLINE_NOTICE_SCAN_MS=3600000

# Opcional: habilitar solo después de configurar proveedor, modelo disponible y clave privada.
AI_WRITING_ENABLED=false
AI_WRITING_PROVIDER=GROQ
AI_WRITING_MODEL=
GROQ_API_KEY=
OPENAI_API_KEY=
AI_WRITING_TIMEOUT_SECONDS=30
AI_WRITING_MAX_INPUT_CHARACTERS=8000
AI_WRITING_MAX_OUTPUT_TOKENS=2000
AI_WRITING_USER_LIMIT=15
AI_WRITING_CONCURRENCY=2
